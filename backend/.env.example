# Rise ’n’ Shine – Backend Environment Configuration

# Database: Neon PostgreSQL connection string (or SQLite for local fallback)
# Format for Neon: postgresql+psycopg2://<user>:<password>@<ep-xyz>.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg2://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Security Secrets (Must be changed in production)
SECRET_KEY=rise-n-shine-super-secure-production-jwt-editorial-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Security (Set SECURE_COOKIE=true in HTTPS production environments)
SECURE_COOKIE=false
COOKIE_SAMESITE=lax

# Publishing Limits
MAX_UPLOAD_SIZE_MB=5

# Initial Administrator Credentials (used for initial bootstrapping)
INITIAL_ADMIN_EMAIL=admin@risenshine.com
INITIAL_ADMIN_PASSWORD=RiseAdmin@2026!
INITIAL_ADMIN_NAME=Chief Editorial Administrator

# Production CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","https://rise-n-shine.vercel.app"]
