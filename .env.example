# =====================================================================
# Rise ’n’ Shine – Unified Fullstack Configuration (Vercel & Local)
# =====================================================================

# 1. Database Connection (Neon Serverless PostgreSQL)
# When importing to Vercel, set this Environment Variable in your Vercel Project Settings:
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<ep-xyz>.neon.tech/neondb?sslmode=require

# 2. JWT & Security Secrets
SECRET_KEY=rise-n-shine-super-secure-production-jwt-editorial-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. Cookie Security
# Set SECURE_COOKIE=true when deploying to HTTPS production on Vercel
SECURE_COOKIE=false
COOKIE_SAMESITE=lax

# 4. Publishing Limits
MAX_UPLOAD_SIZE_MB=5

# 5. Initial Administrator Credentials
INITIAL_ADMIN_EMAIL=admin@risenshine.com
INITIAL_ADMIN_PASSWORD=RiseAdmin@2026!
INITIAL_ADMIN_NAME=Chief Editorial Administrator
